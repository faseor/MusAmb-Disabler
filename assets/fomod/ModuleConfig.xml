<?xml version="1.0" encoding="utf-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
	<moduleName>MusAmbients Disabler</moduleName>
	<moduleImage path="fomod\splash.png" />
	<requiredInstallFiles>
		<folder source="gamedata" destination="gamedata" priority="0" />
	</requiredInstallFiles>
	<installSteps order="Explicit">
		<installStep name="Ready to install">
			<optionalFileGroups order="Explicit">
				<group name=" " type="SelectAll">
					<plugins order="Explicit">
						<plugin name="MusAmbients Disabler">
							<description>Disables background music when entering faction territories and re-enables it afterward. Also supports emissions, weather, dynamic music and the Crawling Mist and Bloodmoon mods.</description>
							<image path="fomod\splash.png" />
							<files />
							<typeDescriptor>
								<type name="Required" />
							</typeDescriptor>
						</plugin>
					</plugins>
				</group>
			</optionalFileGroups>
		</installStep>
	</installSteps>
</config>